# Start with `python -m trustsql.cli seed` and `python -m uvicorn trustsql.app:app --port 8000`.
TRUSTSQL_ENVIRONMENT=development
TRUSTSQL_MODE=demo
TRUSTSQL_WAREHOUSE_URL=sqlite:///var/warehouse.db
TRUSTSQL_CONTROL_DATABASE_URL=sqlite:///var/control.db
TRUSTSQL_API_TOKEN=
TRUSTSQL_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TRUSTSQL_MAX_ROWS=200
TRUSTSQL_QUERY_TIMEOUT_SECONDS=5
TRUSTSQL_RATE_LIMIT_PER_MINUTE=20
TRUSTSQL_MAX_CONCURRENT_QUERIES=4
TRUSTSQL_AS_OF_DATE=2026-11-15
# Live mode requires a real LLM and a DataHub endpoint; it never silently falls back.
TRUSTSQL_LLM_BASE_URL=https://api.openai.com/v1
TRUSTSQL_LLM_MODEL=gpt-4.1-mini
TRUSTSQL_LLM_API_KEY=
TRUSTSQL_DATAHUB_GRAPHQL_URL=http://localhost:8080/api/graphql
TRUSTSQL_DATAHUB_TOKEN=
TRUSTSQL_METADATA_CACHE_SECONDS=60
# See docs/DEPLOYMENT.md before setting production.

